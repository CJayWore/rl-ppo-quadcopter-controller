 @article{article_507222, title={Dynamic Modeling and Simulation of Quadcopter for Several Flight Conditions}, journal={Avrupa Bilim ve Teknoloji Dergisi}, pages={132–142}, year={2019}, DOI={10.31590/ejosat.507222}, author={Oktay, Tuğrul and Köse, Oğuz}, keywords={quadcopter,quadrotor,uav,zankacopter,PID,durum uzay modeli,kontrol}, abstract={<p class="MsoNormal" style="margin-bottom:.0001pt;text-align:justify;line-height:normal;"> <span lang="en-us" style="font-size:10pt;font-family:’Times New Roman’, serif;" xml:lang="en-us">In this paper, a
